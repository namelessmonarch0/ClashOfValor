{
    // These delegate to the Makefile rather than compiling ${file} directly.
    // The previous auto-generated task built a single file with plain g++ and
    // no -lsqlite3, which stopped working as soon as the project grew past one
    // translation unit -- it failed with "Undefined symbols".
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "make: build game",
            "command": "make",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile and link ./game"
        },
        {
            "type": "shell",
            "label": "make: run tests",
            "command": "make",
            "args": [
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "detail": "Build and run the regression suite"
        },
        {
            "type": "shell",
            "label": "make: clean",
            "command": "make",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Remove build/ and the game binary"
        }
    ]
}
